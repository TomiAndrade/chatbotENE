# Obsoleto: quedan de la integración con Kapso, reemplazada por conexión
# directa a la Cloud API de Meta (ver specs/spec-meta-cloud-api.md). No se
# borran hasta validar Meta en producción — app/kapso.py y sus tests siguen
# vivos y usan estas variables.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# Cloud API de Meta — panel developers.facebook.com, app de WhatsApp Business.
# Las cuatro son obligatorias, sin default (ver spec-validacion-config-arranque.md).
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
# Inventado por vos, se carga igual acá y en el panel de Meta al configurar
# la URL del webhook (verificación GET).
META_VERIFY_TOKEN=
META_API_VERSION=v23.0

# Obligatoria, sin default, en todos los entornos — incluido local (ver
# spec-validacion-config-arranque.md: sin modo dev, corre Postgres o no
# arranca). En producción (Render) se toma de la base administrada — se
# enlaza desde el panel del servicio, NO se escribe a mano acá. Render la
# entrega ya con el esquema `postgresql://`, así que se pega tal cual viene.
# El formato completo es:
#   postgresql://usuario:password@host:5432/nombre_db
DATABASE_URL=postgresql://usuario:password@localhost:5432/bot

# Obligatoria, sin default: fijo | openai_compat | claude. Si es
# openai_compat, además son obligatorias BASE_URL, MODELO y
# OPENAI_COMPAT_API_KEY; si es claude, ANTHROPIC_API_KEY y MODELO.
PROVEEDOR_IA=fijo
DEBUG=true

# Etapa 2 — proveedor de IA
BASE_URL=https://openrouter.ai/api/v1
MODELO=nvidia/nemotron-3-ultra-550b-a55b:free
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
TIMEZONE=America/Argentina/Buenos_Aires
HISTORIAL_MAX_MENSAJES=20
HISTORIAL_DIAS_VALIDEZ=7
LIMITE_MENSAJES_HORA=30

# Etapa "pausa por intervención humana" — minutos que dura la pausa cuando la
# secretaría responde desde la app de WhatsApp Business, contados desde la
# última intervención (se reinicia con cada mensaje nuevo de la secretaría).
PAUSA_HUMANA_MINUTOS=120

# Sin bandeja de entrada no hay quién reciba un escalamiento (ver
# specs/spec-derivacion.md): la herramienta escalar_a_humano no se declara al
# modelo mientras esto sea false. La herramienta y modo_humano siguen
# implementados; se reactiva poniendo esto en true cuando exista bandeja.
ESCALAMIENTO_HABILITADO=false
