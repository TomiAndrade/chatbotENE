# Obsoleto: quedan de la integración con Kapso, reemplazada por conexión
# directa a la Cloud API de Meta (ver specs/spec-meta-cloud-api.md). No se
# borran hasta validar Meta en producción — app/kapso.py y sus tests siguen
# vivos y usan estas variables.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# Cloud API de Meta — panel developers.facebook.com, app de WhatsApp Business.
# Las cuatro son obligatorias, sin default (ver spec-validacion-config-arranque.md).
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
# Inventado por vos, se carga igual acá y en el panel de Meta al configurar
# la URL del webhook (verificación GET).
META_VERIFY_TOKEN=
META_API_VERSION=v23.0

# Obligatoria, sin default, en todos los entornos — incluido local (ver
# spec-validacion-config-arranque.md: sin modo dev, corre Postgres o no
# arranca). En producción (Render) se toma de la base administrada — se
# enlaza desde el panel del servicio, NO se escribe a mano acá. Render la
# entrega ya con el esquema `postgresql://`, así que se pega tal cual viene.
# El formato completo es:
#   postgresql://usuario:password@host:5432/nombre_db
DATABASE_URL=postgresql://usuario:password@localhost:5432/bot

# Obligatoria, sin default: fijo | openai_compat | claude. Si es
# openai_compat, además son obligatorias BASE_URL, MODELO y
# OPENAI_COMPAT_API_KEY; si es claude, ANTHROPIC_API_KEY y MODELO.
PROVEEDOR_IA=fijo
DEBUG=true

# Etapa 2 — proveedor de IA
BASE_URL=https://openrouter.ai/api/v1
# El modelo validado contra el prompt real. Ojo con reemplazarlo por uno
# "free" de OpenRouter sin probarlo: nvidia/nemotron-3-ultra-550b-a55b:free
# estuvo acá desde el primer commit y devuelve la respuesta VACÍA con este
# prompt, porque gasta el techo de max_tokens razonando.
MODELO=openai/gpt-5-mini
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
TIMEZONE=America/Argentina/Buenos_Aires
HISTORIAL_MAX_MENSAJES=20
HISTORIAL_DIAS_VALIDEZ=7
LIMITE_MENSAJES_HORA=30

# Agrupar mensajes de texto consecutivos (ver
# specs/spec-agrupamiento-mensajes.md) en una sola respuesta. VENTANA es
# cuánto se espera en silencio antes de dar por terminada una ráfaga;
# ESPERA_MAXIMA es el tope duro desde que arranca la espera, aunque sigan
# llegando mensajes; ABANDONO_SEGUNDOS es a partir de cuándo una generación
# que quedó a medias (el proceso se cayó) se puede retomar — tiene que ser
# mayor que ESPERA_MAXIMA + el presupuesto de la llamada al modelo (20s,
# ver PRESUPUESTO_TOTAL_SEGUNDOS en app/respuesta.py) + los reintentos de
# envío a Meta.
AGRUPAR_VENTANA_SEGUNDOS=5
AGRUPAR_ESPERA_MAXIMA_SEGUNDOS=15
AGRUPAR_ABANDONO_SEGUNDOS=60

# Etapa "pausa por intervención humana" — minutos que dura la pausa cuando la
# secretaría responde desde la app de WhatsApp Business, contados desde la
# última intervención (se reinicia con cada mensaje nuevo de la secretaría).
PAUSA_HUMANA_MINUTOS=120

# Sin bandeja de entrada no hay quién reciba un escalamiento (ver
# specs/spec-derivacion.md): la herramienta escalar_a_humano no se declara al
# modelo mientras esto sea false. La herramienta y modo_humano siguen
# implementados; se reactiva poniendo esto en true cuando exista bandeja.
ESCALAMIENTO_HABILITADO=false

# CRM — panel de conversaciones en /crm (ver specs/spec-crm-conversaciones.md).
# El login es propio: cada persona entra con su usuario y su contraseña, y
# las cuentas viven en la base (tabla crm_usuarios), no acá. **No hay ninguna
# contraseña en este archivo**, ni compartida ni de nadie: la primera cuenta
# se crea desde la consola con
#   python scripts/crm_usuario.py crear <usuario>
# que pide la contraseña sin mostrarla y guarda solo su hash Argon2id.
#
# Viene apagado: con CRM_HABILITADO=false no se registra ninguna ruta del
# panel y /crm responde 404. Prendido, CRM_BASE_URL es obligatoria y el
# arranque corta si falta o si es http fuera de localhost.
CRM_HABILITADO=false

# La URL pública del panel, sin barra final y sin ruta. De acá sale una sola
# decisión: si la cookie de sesión va con el flag Secure. No se deduce del
# header Host a propósito — eso lo pone quien manda el request.
# HTTPS obligatorio, salvo localhost con DEBUG=true para desarrollo.
CRM_BASE_URL=http://localhost:8000

# Control preventivo de gasto de WhatsApp/Meta, etapa 1
# (specs/spec-costo-whatsapp-meta.md): registrar wa_message_id y costo
# estimado por envío, y poder ver el consumo mensual estimado en el CRM.
# Todavía NO implementa alertas de porcentaje ni tope duro — eso es etapa 2.
# Tarifa de referencia para Argentina desde 01/10/2026 (categoría Service) y
# presupuesto mensual inicial, ~1.000 mensajes Service bajo ese supuesto. Las
# dos tienen que ser mayores a 0 (validar_config() corta el arranque si no).
META_TARIFA_SERVICE_ARS=37.6798
META_PRESUPUESTO_MENSUAL_ARS=37679.80

# Etapa 2.1 del control de gasto (specs/spec-tope-duro-meta.md): bloqueo
# duro mensual. Con esto en false (el default) el comportamiento es
# idéntico al de la etapa 1 — no se reserva nada, no se bloquea ningún
# envío. Prendido, un mensaje que superaría el presupuesto del mes no
# llega a mandarse a Meta. Sin alertas 70/90% todavía.
META_TOPE_DURO_HABILITADO=false
